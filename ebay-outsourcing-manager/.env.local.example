# このファイルを「.env.local」という名前でコピーして、実際の値を入れてください。
# 値は Supabase管理画面 → Settings → API からコピーできます。

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...（長い文字列）

# ─── Chatwork通知（任意・Phase 8） ───────────────────────────
# 設定しない場合、通知は送られませんがアプリは正常に動きます。
# CHATWORK_API_TOKEN: Chatwork → 右上のアカウント名 → サービス連携 → API Token
# CHATWORK_ROOM_ID:   通知したいチャットを開いたときのURL末尾の数字
# NEXT_PUBLIC_APP_URL: 通知メッセージに載せるツールのURL（末尾のスラッシュなし）
CHATWORK_API_TOKEN=
CHATWORK_ROOM_ID=
NEXT_PUBLIC_APP_URL=https://ebay-inventory-4tzs.vercel.app
